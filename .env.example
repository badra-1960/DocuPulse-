# =============================================================================
# DOCUPULSE SAAS - ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================
# Toutes les variables sensibles sont lues exclusivement côté serveur Node.js.
# ZÉRO secret ou clé privée ne doit porter le préfixe VITE_ ni être injecté au frontend.

# Port d'écoute du serveur Node.js / Express (Cloud Run injecte dynamiquement PORT)
PORT=3000

# Environnement d'exécution (development | production)
NODE_ENV=production

# URL publique de production du service DocuPulse (utilisée pour CORS et redirections de paiement)
APP_URL=https://votre-domaine.com

# Clé API Google Gemini (AI Studio / Google Cloud Vertex AI)
# Requise exclusivement sur le serveur pour le module OCR et analyse de texte
GEMINI_API_KEY=

# Clé secrète de signature des sessions HMAC SHA-256 (Générer une clé aléatoire de 64 caractères)
SESSION_SECRET=

# Email et mot de passe de l'administrateur système (Le mot de passe doit être haché en SHA-256)
ADMIN_EMAIL=admin@docupulse.io
ADMIN_PASSWORD_HASH=

# Choix du fournisseur de paiement actif : 'stripe' | 'lemonsqueezy' | 'paddle' | 'cinetpay' | 'sandbox'
BILLING_PROVIDER=stripe

# 1. Option Stripe (Cartes bancaires internationales)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# 2. Option Merchant of Record (Lemon Squeezy / Paddle)
# Recommandé si le titulaire est domicilié en Afrique / Guinée (gestion TVA mondiale & reversement Payoneer/Wise)
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_PRO_VARIANT_ID=
LEMONSQUEEZY_BUSINESS_VARIANT_ID=

# 3. Option Mobile Money Régional (CinetPay / PayDunya / Notch Pay)
# Permet d'encaisser Orange Money Guinée, MTN Mobile Money, Moov, Wave
CINETPAY_SITE_ID=
CINETPAY_API_KEY=

# Plafond global quotidien de protection de l'infrastructure IA (requêtes / jour pour tout le serveur)
GLOBAL_GEMINI_DAILY_LIMIT=1000


